{
  "name": "niveshrakshak-suite",
  "version": "2.0.0",
  "description": "NiveshRakshak — AI Investor Rights & Grievance Assistant",
  "scripts": {
    "rag:ingest": "cd ai-service && .venv/bin/python rag/ingest.py --data-dir ../data/rag_data",
    "rag:reindex": "cd ai-service && .venv/bin/python rag/ingest.py --data-dir ../data/rag_data --reindex",
    "rag:evaluate": "cd ai-service && .venv/bin/python rag/evaluator.py",
    "start:ai": "cd ai-service && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000",
    "start:backend": "cd backend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": ["investor-protection", "sebi", "grievance", "rag", "fintech", "ai-assistant"],
  "author": "NiveshRakshak Team",
  "license": "MIT"
}
